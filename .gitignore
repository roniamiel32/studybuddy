.env
.env.*
!.env.example

# --- Supabase local dev ---
supabase/.branches/
supabase/.temp/
supabase/.env

# --- Testing / coverage ---
coverage/
.nyc_output/
playwright-report/
test-results/
/blob-report/
.playwright/

# --- Claude Code local state (machine-specific, not shared) ---
.claude/settings.local.json

# --- Editors / tooling caches ---
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.eslintcache
*.log
