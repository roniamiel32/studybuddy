# StudyBuddy — environment template
#
# Authors: Roni Amiel & Eden Bitran
#
# Copy to .env.local and fill in. Every variable here is validated by
# src/lib/env.ts at boot, so a typo fails immediately with a message naming the
# offending variable rather than surfacing later as a confusing error.
#
#   cp .env.example .env.local
#
# .env.local is gitignored. Never commit real keys.

# ------------------------------------------------------------------------------
# Supabase — browser-safe
# ------------------------------------------------------------------------------
# For local development, run `npm run db:start` and copy the values it prints
# ("API URL" and the anon/publishable key). They are container-local and
# identical on every machine, but the exact format depends on your CLI version,
# so copy rather than guess.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used to build auth redirect URLs. Must match the origin you browse on.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase — server only. NEVER prefix with NEXT_PUBLIC_.
# ------------------------------------------------------------------------------
# Bypasses Row Level Security entirely. Used only by the AI route handlers to
# write match_scores and ai_generation_log, and by seed scripts. See
# src/lib/supabase/admin.ts. `npm run db:start` prints the local value.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# AI — optional
# ------------------------------------------------------------------------------
# Every AI feature is optional, and the app is fully usable without a key:
# matching falls back to the deterministic SQL ranking, match cards omit the
# "why you match" line, and a degree with no course catalog shows an empty step 2
# the student can continue past. Both a key AND a model are required before any
# of it switches on.
#
# In use now: the Smart Course API (POST /api/courses), which builds a degree's
# course list when the database has none, and the Smart Icebreaker
# (POST /api/icebreaker), which writes the opening message of a conversation.
# Without a key both fall back to hand-built content and the features still work.
# Match re-ranking is still to come.
AI_PROVIDER=anthropic
AI_API_KEY=
# No default in code on purpose — a model id pinned in source goes stale. Set
# this to the model you actually intend to call.
AI_MODEL=

# Per-user daily caps, enforced from ai_generation_log. See design sections 6.4
# and 11.4. Counted per task, so these do not ration each other.
AI_RERANK_DAILY_LIMIT=20
AI_ICEBREAKER_DAILY_LIMIT=30
AI_COURSE_GENERATION_DAILY_LIMIT=5

# Hours a cached match_scores row stays fresh before a re-rank is allowed.
MATCH_CACHE_TTL_HOURS=24
